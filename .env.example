# Backend API URL (for legacy backend calls)
VITE_API_URL=http://localhost:3000/api

# Stellar Network Configuration
VITE_STELLAR_NETWORK=TESTNET
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Deployment ID (Soroban Testnet)
VITE_STORMSALE_CONTRACT_ID=

# ── Upstash Redis (Custom Short-Link Shared Store) ────────────────────────────
# Required for the /api/custom-links/* Vercel serverless functions.
# Provision a free Upstash Redis database at:
#   https://vercel.com/marketplace?category=storage&search=redis
# OR directly at: https://console.upstash.com
# Then add these values to Vercel's Environment Variables dashboard
# (Settings → Environment Variables) and to your local .env.local for dev.
#
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
